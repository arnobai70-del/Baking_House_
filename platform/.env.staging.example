# Baking House — STAGING environment template (Phase 9).
# Copy to .env on the staging server and fill the blanks. Never commit the real file.
# Staging is private, never indexed, and payments stay in TEST mode.

APP_NAME="Baking House"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=info

# MySQL / MariaDB (not SQLite)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bakinghouse_staging
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database

# HTTPS and proxies
FORCE_HTTPS=true
# Comma-separated load-balancer IPs / CIDRs, or * only if the proxy overwrites X-Forwarded-*
TRUSTED_PROXIES=

# Private staging: HTTP Basic for testers (hash: php artisan tinker --execute "echo bcrypt('…');")
STAGING_GATE_ENABLED=true
STAGING_GATE_USER=
STAGING_GATE_PASSWORD_HASH=

# Never indexed
SEO_INDEXING_ENABLED=false

# Payments: TEST MODE ONLY (live payments are not authorised)
PAYMENTS_MODE=test
PAYMENTS_TEST_SECRET_BKASH=
PAYMENTS_TEST_SECRET_NAGAD=
PAYMENTS_TEST_SECRET_CARD=

# Notifications: log-only until providers are contracted
MAIL_MAILER=log
SMS_DRIVER=log

# Photos
MEDIA_REQUIRE_SECOND_REVIEWER=true
MEDIA_AVIF=true

# Invoices / bank transfer: leave as placeholders until the owner supplies verified details
SELLER_LEGAL_NAME="Baking House"
SELLER_ADDRESS=
SELLER_PHONE=
SELLER_VAT_BIN=
